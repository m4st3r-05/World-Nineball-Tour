<%- include('partials/header') %>

<section class="rankings-hero" aria-label="World Nineball Rankings banner"></section>

<section class="rankings-page">
    <div class="rankings-brand-tab">wnt<span>.</span></div>
    <div class="rankings-panel">
        <div class="rankings-panel-heading">
            <div>
                <p>WORLD NINEBALL TOUR</p>
                <h1>World Rankings</h1>
            </div>
            <span><%= players.length %> PLAYERS</span>
        </div>

        <ol class="rankings-list">
            <% players.forEach(function(player, index) { %>
                <li class="rankings-row <%= index === 0 ? 'rankings-row-first' : '' %>">
                    <span class="rankings-position">#<%= player.rank || index + 1 %></span>
                    <% if (player.portrait) { %>
                        <img class="rankings-portrait" src="<%= player.portrait %>" alt="<%= player.name %>">
                    <% } else { %>
                        <span class="rankings-flag" aria-hidden="true"><%= player.flag || '●' %></span>
                    <% } %>
                    <div class="rankings-player">
                        <span class="rankings-player-name"><%= player.name %></span>
                        <span class="rankings-country"><%= player.country || '—' %></span>
                    </div>
                    <span class="rankings-points"><%= Number(player.points || 0).toLocaleString('en-US') %><small>PTS</small></span>
                </li>
            <% }); %>
        </ol>
    </div>
</section>

<%- include('partials/footer') %>
