<%- include('partials/header') %>

<section class="page-header" style="background: linear-gradient(to bottom, #111, var(--bg-dark));">
    <h1>⚙️ BẢNG QUẢN TRỊ HỆ THỐNG</h1>
    <p style="color: var(--neon-gold);">Chào mừng Quản trị viên, bạn có quyền chỉnh sửa toàn bộ dữ liệu WNT.</p>
</section>

<section class="container mt-5 mb-5">
    
    <!-- Quản lý Giải đấu -->
    <div class="card mb-5">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1rem; margin-bottom: 1.5rem;">
            <h2>🏆 Quản Lý Giải Đấu</h2>
            <button class="btn btn-primary">+ THÊM GIẢI MỚI</button>
        </div>
        
        <table class="ranking-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tên Giải Đấu</th>
                    <th>Loại Giải</th>
                    <th>Trạng Thái</th>
                    <th>Hành Động</th>
                </tr>
            </thead>
            <tbody>
                <% tournaments.forEach(t => { %>
                    <tr>
                        <td><%= t.id %></td>
                        <td style="font-weight: bold;"><%= t.name %></td>
                        <td class="<%= t.type === 'Major' ? 'text-gold' : 'text-cyan' %>"><%= t.type %></td>
                        <td><%= t.status %></td>
                        <td>
                            <button class="btn btn-small" style="background-color: var(--neon-cyan); color: #000;">Sửa</button>
                            <button class="btn btn-small" style="background-color: var(--live-red); color: #fff;">Xóa</button>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- Quản lý Cơ thủ -->
    <div class="card mb-5">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1rem; margin-bottom: 1.5rem;">
            <h2>🧑‍🤝‍🧑 Quản Lý 32 Người Chơi (Top WNT Players)</h2>
            <button class="btn btn-primary">+ THÊM CƠ THỦ</button>
        </div>
        
        <table class="ranking-table">
            <thead>
                <tr>
                    <th>Hạng</th>
                    <th>Tên Cơ Thủ</th>
                    <th>Quốc Gia</th>
                    <th>Điểm</th>
                    <th>Hành Động</th>
                </tr>
            </thead>
            <tbody>
                <% players.forEach(p => { %>
                    <tr>
                        <td>#<%= p.rank %></td>
                        <td style="font-weight: bold;"><%= p.name %></td>
                        <td><%= p.country %></td>
                        <td class="text-gold"><%= p.points %></td>
                        <td>
                            <button class="btn btn-small" style="background-color: var(--neon-cyan); color: #000;">Sửa</button>
                            <button class="btn btn-small" style="background-color: var(--live-red); color: #fff;">Xóa</button>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1rem; margin-bottom: 1.5rem;">
            <h2>📊 Cập Nhật Tỷ Số Trận Đấu</h2>
            <span class="text-gold">Admin-only</span>
        </div>

        <div style="display: grid; gap: 1rem;">
            <% tournamentMatches.slice(0, 6).forEach(match => { %>
                <form method="POST" action="/admin/matches/<%= match.id %>/score" style="display: grid; grid-template-columns: 1.5fr 90px 90px 1.5fr auto auto; gap: 0.75rem; align-items: center; background: rgba(255,255,255,0.03); padding: 0.75rem 1rem; border-radius: 8px;">
                    <div><strong><%= match.p1_name %></strong></div>
                    <input type="number" name="score1" value="<%= match.score1 %>" min="0" max="9" style="width: 100%; padding: 0.5rem; border-radius: 6px; border: none; background: rgba(255,255,255,0.08); color: #fff;">
                    <span style="text-align: center; color: var(--neon-gold); font-weight: 800;">VS</span>
                    <input type="number" name="score2" value="<%= match.score2 %>" min="0" max="9" style="width: 100%; padding: 0.5rem; border-radius: 6px; border: none; background: rgba(255,255,255,0.08); color: #fff;">
                    <div><strong><%= match.p2_name %></strong></div>
                    <label style="display: flex; align-items: center; gap: 0.4rem; color: var(--live-red); font-weight: 700;">
                        <input type="checkbox" name="is_live" <%= match.is_live ? 'checked' : '' %>>
                        Live
                    </label>
                    <button type="submit" class="btn btn-small" style="background-color: var(--neon-gold); color: #000;">Lưu</button>
                </form>
            <% }) %>
        </div>
    </div>

</section>

<%- include('partials/footer') %>
