<%- include('partials/header') %>

<section class="change-pw-page">
    <div class="change-pw-container">
        <div class="change-pw-card">
            <div class="change-pw-badge-wrap">
                <div class="change-pw-badge">
                    <span>Change Password</span>
                </div>
            </div>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="pw-alert pw-alert-success"><%= success %></div>
            <% } %>
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="pw-alert pw-alert-error"><%= error %></div>
            <% } %>

            <form action="/profile/change-password" method="POST" class="change-pw-form">
                <div class="pw-field">
                    <input type="password" name="current_password" placeholder="Current password" required>
                </div>
                <div class="pw-field">
                    <input type="password" name="new_password" placeholder="New password" required>
                </div>
                <div class="pw-field">
                    <input type="password" name="confirm_password" placeholder="Confirm password" required>
                </div>
                <div class="pw-action">
                    <button type="submit" class="btn-change-pw">Change password</button>
                </div>
            </form>
        </div>

        <p class="change-pw-note">
            *If you don't remember your current password, you can restore it by <strong>clicking here</strong>.
        </p>
    </div>
</section>

<style>
.change-pw-page {
    background-color: #eef1f5;
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 20px 90px;
    box-sizing: border-box;
}

.change-pw-container {
    width: 100%;
    max-width: 980px;
}

.change-pw-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid #e2e7ee;
    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.05);
    position: relative;
    padding: 46px 45px 36px;
    margin-bottom: 18px;
}

.change-pw-badge-wrap {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
}

.change-pw-badge {
    background-color: #14243b;
    color: #ffffff;
    padding: 10px 58px;
    border-radius: 0 0 16px 16px;
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
}

.change-pw-form {
    margin-top: 15px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.pw-field input {
    width: 100%;
    height: 54px;
    background: #ffffff;
    border: 1px solid #d4dae3;
    border-radius: 9px;
    padding: 0 20px;
    font-size: 0.98rem;
    font-family: inherit;
    color: #1a2a3a;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.pw-field input::placeholder {
    color: #8c9ba9;
    font-weight: 400;
}

.pw-field input:focus {
    border-color: #14243b;
    box-shadow: 0 0 0 3px rgba(20, 36, 59, 0.08);
}

.pw-action {
    display: flex;
    justify-content: flex-end;
    margin-top: 6px;
}

.btn-change-pw {
    background-color: #1a7c52;
    color: #ffffff;
    border: none;
    border-radius: 24px;
    padding: 12px 34px;
    font-size: 1rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.15s, box-shadow 0.2s;
    box-shadow: 0 4px 12px rgba(26, 124, 82, 0.25);
}

.btn-change-pw:hover {
    background-color: #219663;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(26, 124, 82, 0.35);
}

.btn-change-pw:active {
    transform: translateY(0);
}

.change-pw-note {
    font-size: 0.88rem;
    font-style: italic;
    color: #3e4a59;
    margin: 0;
    padding-left: 4px;
    line-height: 1.5;
}

.change-pw-note strong {
    font-weight: 800;
    color: #14243b;
    cursor: pointer;
}

.pw-alert {
    padding: 12px 18px;
    border-radius: 8px;
    font-size: 0.92rem;
    font-weight: 600;
    margin: 10px 0 16px;
}

.pw-alert-success {
    background: #e7f7ed;
    color: #177a43;
    border: 1px solid #b7e8c9;
}

.pw-alert-error {
    background: #fde8e8;
    color: #c81e1e;
    border: 1px solid #f8b4b4;
}

@media (max-width: 768px) {
    .change-pw-card {
        padding: 40px 20px 25px;
    }
    .change-pw-badge {
        padding: 8px 30px;
        font-size: 1.1rem;
    }
    .pw-field input {
        height: 48px;
    }
    .pw-action {
        justify-content: center;
    }
    .btn-change-pw {
        width: 100%;
    }
}
</style>

<%- include('partials/footer') %>