}
.td-title-gold { color: #c9a227; }
.td-title-blue { color: #1a2d5a; }
.td-title-divider {
    height: 2px;
    width: 80px;
    background: #c9a227;
    margin: 0 auto 20px auto;
    border-radius: 2px;
}

/* META GRID */
.td-meta-grid {
