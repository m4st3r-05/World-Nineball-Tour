    margin: 0 30px;
    background: #0a1628;
    border-radius: 10px;
    padding: 24px 30px;
}
.td-prize-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px 16px;
}
.td-prize-pos {
    font-size: 0.78rem;
    font-weight: 700;
    color: #5a9fd4;
    margin-bottom: 4px;
}
.td-prize-amt {
    font-size: 1.3rem;
    font-weight: 900;
    color: #fff;
    font-style: italic;
}

/* BOTTOM TAB BAR */
.td-tabbar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    border-top: 1px solid #dde3ec;
