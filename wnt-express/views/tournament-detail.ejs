.td-hero {
    width: 100%;
    height: 280px;
    background-size: cover;
    background-position: center top;
    position: relative;
}
.td-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(10,13,30,0.25) 0%, rgba(10,13,30,0.55) 100%);
}

/* WRAPPER */
.td-wrapper {
    background: #fff;
    max-width: 980px;
    margin: -40px auto 120px auto;
    border-radius: 14px;
    box-shadow: 0 8px 40px rgba(0,0,0,0.18);
    padding: 0 0 30px 0;
    position: relative;
    z-index: 10;
}

/* EVENT INFO BADGE */
.td-info-badge-wrap {
    display: flex;
    justify-content: center;
    margin-top: -20px;
}
.td-info-badge {
    background: #0a1628;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    padding: 11px 50px;
    border-radius: 8px;
}

/* TITLE */
