<%- include('partials/header') %>

<!-- HERO BANNER -->
<div class="td-hero" style="background-image: url('<%= tournament.heroImage || tournament.hero_image || '/img/world-pool-championship.jpg' %>');">  
    <div class="td-hero-overlay"></div>
</div>

<!-- MAIN CONTENT WRAPPER -->
<div class="td-wrapper">

    <!-- EVENT INFO HEADER BADGE -->
    <div class="td-info-badge-wrap">
        <div class="td-info-badge">
            EVENT INFO
        </div>
    </div>

    <!-- TOURNAMENT TITLE -->
    <div class="td-title-block">
        <h1 class="td-title">
            <span class="td-title-gold"><%= tournament.shortName || tournament.short_name || 'TOURNAMENT' %></span>
            <span class="td-title-blue"><%= tournament.subtitle || 'CHAMPIONSHIP' %></span>
        </h1>
        <div class="td-title-divider"></div>
    </div>

    <!-- EVENT META (Date / Venue / Location / Prize fund) -->
    <div class="td-meta-grid">
        <div class="td-meta-item">
            <div class="td-meta-label">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Date
            </div>
            <div class="td-meta-value"><%= tournament.dateRange || tournament.date_range || tournament.date || 'TBD' %></div>
        </div>
        <div class="td-meta-item">
            <div class="td-meta-label">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                Venue
            </div>
            <div class="td-meta-value"><%= tournament.venue %></div>
        </div>
        <div class="td-meta-item">
            <div class="td-meta-label">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                Location
            </div>
            <div class="td-meta-value"><%= (tournament.location || 'TBD').split(',')[0] %></div>
        </div>
        <div class="td-meta-item">
            <div class="td-meta-label">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                Prize fund
            </div>
            <div class="td-meta-value"><%= tournament.prize %></div>
        </div>
    </div>

    <!-- PRIZE BREAKDOWN -->
    <% const prizeBreakdown = Array.isArray(tournament.prizeBreakdown) ? tournament.prizeBreakdown : []; %>
    <% if (prizeBreakdown.length) { %>
    <div class="td-prize-block">
        <div class="td-prize-grid">
            <% prizeBreakdown.forEach(function(p) { %>
            <div class="td-prize-item">
                <div class="td-prize-pos"><%= p.position %></div>
                <div class="td-prize-amt"><%= p.amount %></div>
            </div>
            <% }); %>
        </div>
    </div>
    <% } %>

</div>

<!-- BOTTOM TAB BAR -->
<div class="td-tabbar">
    <a href="/tournaments/<%= tournament.id %>" class="td-tab td-tab-active" id="tab-info">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
        Info
    </a>
    <a href="#matches-section" class="td-tab" id="tab-matches">
        <span style="font-weight:900; font-size:0.7rem;">VS.</span>
        Matches
    </a>
    <a href="#live-section" class="td-tab" id="tab-live">
        <span class="td-live-dot"></span>
        Live
    </a>
    <a href="#ranking-section" class="td-tab" id="tab-ranking">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        Ranking
    </a>
</div>

<section id="matches-section" class="td-matches-wrap" style="display: none;">
    <div class="td-matches-header">
        <div class="td-matches-title">32-player knockout</div>
        <div class="td-matches-meta">Race to 9 • live scores</div>
    </div>

    <% const tournamentMatches = Array.isArray(tournament.matches) ? tournament.matches : []; %>
    <% tournamentMatches.forEach(function(round, roundIndex) { %>
        <div class="td-round-block">
            <div class="td-round-header"><%= round.label %></div>
            <% const roundMatches = Array.isArray(round.matches) ? round.matches : []; %>
            <% roundMatches.forEach(function(match) { %>
                <div class="td-match-row">
                    <div class="td-match-seed">#<%= match.player1 && match.player1.rank ? match.player1.rank : '' %></div>
                    <div class="td-player td-player-left">
                        <span class="td-player-name"><%= match.player1 ? match.player1.name : 'TBD' %></span>
                        <span class="td-country"><%= match.player1 ? match.player1.country : '' %></span>
                    </div>

                    <div class="td-score-box">
                        <span class="td-score <%= Number(match.score1) === Number(tournament.raceTarget || 9) ? 'td-score-winner' : '' %>"><%= match.score1 || 0 %></span>
                        <span class="td-score-divider">vs</span>
                        <span class="td-score <%= Number(match.score2) === Number(tournament.raceTarget || 9) ? 'td-score-winner' : '' %>"><%= match.score2 || 0 %></span>
                    </div>

                    <div class="td-player td-player-right">
                        <span class="td-country"><%= match.player2 ? match.player2.country : '' %></span>
                        <span class="td-player-name"><%= match.player2 ? match.player2.name : 'TBD' %></span>
                    </div>
                    <div class="td-match-time"><%= match.scheduled || 'TBD' %></div>
                </div>
            <% }); %>
        </div>
    <% }); %>
</section>

<section id="live-section" class="td-live-wrap" style="display: none;">
    <div class="td-live-header">
        <div class="td-live-title">Live now</div>
        <div class="td-live-meta">Race to 9</div>
    </div>

    <%
      const liveMatches = Array.isArray(tournament.matches)
        ? tournament.matches.flatMap(function(round) { return Array.isArray(round.matches) ? round.matches : []; })
            .filter(function(match) { return match.is_live === true || match.is_live === 1; })
        : [];
    %>

    <% if (liveMatches.length) { %>
        <% liveMatches.forEach(function(match) { %>
            <div class="td-live-row">
                <div class="td-live-seed">#<%= match.player1.rank %></div>
                <div class="td-live-player"><%= match.player1.name %> <span><%= match.player1.country %></span></div>
                <div class="td-live-score">
                    <span class="td-live-number <%= match.score1 === tournament.raceTarget ? 'td-live-number-winner' : '' %>"><%= match.score1 %></span>
                    <span class="td-live-divider">VS</span>
                    <span class="td-live-number <%= match.score2 === tournament.raceTarget ? 'td-live-number-winner' : '' %>"><%= match.score2 %></span>
                </div>
                <div class="td-live-player td-live-player-right"><%= match.player2.name %> <span><%= match.player2.country %></span></div>
                <div class="td-live-time"><%= match.scheduled %></div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="td-live-empty">No live matches at the moment.</div>
    <% } %>
</section>

<section id="ranking-section" class="td-ranking-wrap" style="display: none;">
    <div class="td-ranking-header">
        <div class="td-ranking-title">Top 4 prize ranking</div>
        <div class="td-ranking-meta"><%= tournament.shortName || tournament.short_name || tournament.name %></div>
    </div>
    <%
      const rankingPlayers = Array.isArray(tournament.participants)
        ? tournament.participants.slice().sort(function(a, b) { return Number(a.rank || 0) - Number(b.rank || 0); }).slice(0, 4)
        : [];
      const rankingPayouts = Array.isArray(tournament.prizeBreakdown) ? tournament.prizeBreakdown : [];
      const getPayout = function(position) {
        const prize = rankingPayouts.find(function(item) {
          return String(item.position || '').toLowerCase() === position;
        });
        return prize ? prize.amount : '—';
      };
      const semiFinalistPayout = getPayout('semi-finalists');
    %>
    <% if (rankingPlayers.length) { %>
        <% rankingPlayers.forEach(function(player, index) { %>
            <div class="td-ranking-row <%= index === 0 ? 'td-ranking-row-first' : '' %>">
                <div class="td-ranking-place">#<%= index + 1 %></div>
                <% if (player.portrait) { %>
                    <img class="td-ranking-portrait" src="<%= player.portrait %>" alt="<%= player.name %>">
                <% } else { %>
                    <div class="td-ranking-flag"><%= player.flag || '' %></div>
                <% } %>
                <div class="td-ranking-player">
                    <div class="td-ranking-name"><%= player.name %></div>
                    <div class="td-ranking-country"><%= player.country || '' %></div>
                </div>
                <div class="td-ranking-prize"><%= index === 0 ? getPayout('champion') : index === 1 ? getPayout('runner-up') : semiFinalistPayout %></div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="td-ranking-empty">No ranking data available.</div>
    <% } %>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const infoTab = document.getElementById('tab-info');
    const matchesTab = document.getElementById('tab-matches');
    const liveTab = document.getElementById('tab-live');
    const rankingTab = document.getElementById('tab-ranking');
    const infoWrap = document.querySelector('.td-wrapper');
    const matchWrap = document.getElementById('matches-section');
    const liveWrap = document.getElementById('live-section');
    const rankingWrap = document.getElementById('ranking-section');

    function showInfo() {
      if (infoWrap) infoWrap.style.display = 'block';
      if (matchWrap) matchWrap.style.display = 'none';
      if (liveWrap) liveWrap.style.display = 'none';
      if (rankingWrap) rankingWrap.style.display = 'none';
      if (infoTab) infoTab.classList.add('td-tab-active');
      if (matchesTab) matchesTab.classList.remove('td-tab-active');
      if (liveTab) liveTab.classList.remove('td-tab-active');
      if (rankingTab) rankingTab.classList.remove('td-tab-active');
    }

    function showMatches() {
      if (infoWrap) infoWrap.style.display = 'none';
      if (matchWrap) matchWrap.style.display = 'block';
      if (liveWrap) liveWrap.style.display = 'none';
      if (rankingWrap) rankingWrap.style.display = 'none';
      if (matchesTab) matchesTab.classList.add('td-tab-active');
      if (infoTab) infoTab.classList.remove('td-tab-active');
      if (liveTab) liveTab.classList.remove('td-tab-active');
      if (rankingTab) rankingTab.classList.remove('td-tab-active');
    }

    function showLive() {
      if (infoWrap) infoWrap.style.display = 'none';
      if (matchWrap) matchWrap.style.display = 'none';
      if (liveWrap) liveWrap.style.display = 'block';
      if (rankingWrap) rankingWrap.style.display = 'none';
      if (liveTab) liveTab.classList.add('td-tab-active');
      if (matchesTab) matchesTab.classList.remove('td-tab-active');
      if (infoTab) infoTab.classList.remove('td-tab-active');
      if (rankingTab) rankingTab.classList.remove('td-tab-active');
    }

    function showRanking() {
      if (infoWrap) infoWrap.style.display = 'none';
      if (matchWrap) matchWrap.style.display = 'none';
      if (liveWrap) liveWrap.style.display = 'none';
      if (rankingWrap) rankingWrap.style.display = 'block';
      if (rankingTab) rankingTab.classList.add('td-tab-active');
      if (matchesTab) matchesTab.classList.remove('td-tab-active');
      if (liveTab) liveTab.classList.remove('td-tab-active');
      if (infoTab) infoTab.classList.remove('td-tab-active');
    }

    if (infoTab) {
      infoTab.addEventListener('click', function (event) {
        event.preventDefault();
        showInfo();
      });
    }

    if (matchesTab) {
      matchesTab.addEventListener('click', function (event) {
        event.preventDefault();
        showMatches();
      });
    }

    if (liveTab) {
      liveTab.addEventListener('click', function (event) {
        event.preventDefault();
        showLive();
      });
    }

    if (rankingTab) {
      rankingTab.addEventListener('click', function (event) {
        event.preventDefault();
        showRanking();
      });
    }

    showInfo();
  });
</script>

<style>
/* =================== TOURNAMENT DETAIL STYLES =================== */
