<%- include('partials/header') %>

<!-- HERO BANNER -->
<div class="td-hero" style="background-image: url('<%= tournament.heroImage || tournament.hero_image || '/img/world-pool-championship.jpg' %>');">  
    <div class="td-hero-overlay"></div>
</div>

<!-- MAIN CONTENT WRAPPER -->
<div class="td-wrapper">

    <!-- EVENT INFO HEADER BADGE -->
    <div class="td-info-badge-wrap">
        <div class="td-info-badge">
            EVENT INFO
        </div>
    </div>

    <!-- TOURNAMENT TITLE -->
    <div class="td-title-block">
        <h1 class="td-title">
            <span class="td-title-gold"><%= tournament.shortName || tournament.short_name || 'TOURNAMENT' %></span>
            <span class="td-title-blue"><%= tournament.subtitle || 'CHAMPIONSHIP' %></span>
        </h1>
        <div class="td-title-divider"></div>
    </div>

    <!-- EVENT META (Date / Venue / Location / Prize fund) -->
    <div class="td-meta-grid">
        <div class="td-meta-item">
            <div class="td-meta-label">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Date
            </div>
            <div class="td-meta-value"><%= tournament.dateRange || tournament.date_range || tournament.date || 'TBD' %></div>
        </div>
        <div class="td-meta-item">
            <div class="td-meta-label">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                Venue
            </div>
            <div class="td-meta-value"><%= tournament.venue %></div>
        </div>
        <div class="td-meta-item">
            <div class="td-meta-label">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                Location
            </div>
            <div class="td-meta-value"><%= (tournament.location || 'TBD').split(',')[0] %></div>
        </div>
        <div class="td-meta-item">
            <div class="td-meta-label">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                Prize fund
            </div>
            <div class="td-meta-value"><%= tournament.prize %></div>
        </div>
    </div>

    <!-- PRIZE BREAKDOWN -->
    <% const prizeBreakdown = Array.isArray(tournament.prizeBreakdown) ? tournament.prizeBreakdown : []; %>
    <% if (prizeBreakdown.length) { %>
    <div class="td-prize-block">
        <div class="td-prize-grid">
            <% prizeBreakdown.forEach(function(p) { %>
            <div class="td-prize-item">
                <div class="td-prize-pos"><%= p.position %></div>
                <div class="td-prize-amt"><%= p.amount %></div>
            </div>
            <% }); %>
        </div>
    </div>
    <% } %>

</div>

<!-- BOTTOM TAB BAR -->
<div class="td-tabbar">
    <a href="/tournaments/<%= tournament.id %>" class="td-tab td-tab-active" id="tab-info">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
        Info
    </a>
    <a href="#matches-section" class="td-tab" id="tab-matches">
        <span style="font-weight:900; font-size:0.7rem;">VS.</span>
        Matches
    </a>
    <a href="#live-section" class="td-tab" id="tab-live">
        <span class="td-live-dot"></span>
        Live
    </a>
    <a href="#ranking-section" class="td-tab" id="tab-ranking">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        Ranking
    </a>
</div>

<section id="matches-section" class="td-matches-wrap" style="display: none;">
    <div class="td-matches-header">
        <div class="td-matches-title">32-player knockout</div>
        <div class="td-matches-meta">
            Race to <%= tournament.raceTarget || 9 %> • live scores
            <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                <span class="td-admin-badge">⚡ CHẾ ĐỘ QUẢN TRỊ VIÊN</span>
            <% } %>
        </div>
    </div>

    <% const tournamentMatches = Array.isArray(tournament.matches) ? tournament.matches : []; %>
    <% const allPlayersList = Array.isArray(tournament.allPlayers) ? tournament.allPlayers : []; %>
    <% tournamentMatches.forEach(function(round, roundIndex) { %>
        <div class="td-round-block">
            <div class="td-round-header"><%= round.label %></div>
            <% const roundMatches = Array.isArray(round.matches) ? round.matches : []; %>
            <% roundMatches.forEach(function(match) { %>
                <div class="td-match-row <%= (typeof user !== 'undefined' && user && user.role === 'admin') ? 'td-match-row-admin' : '' %>">
                    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                        <!-- Form chỉnh sửa trực tiếp dành cho Admin -->
                        <form method="POST" action="/tournaments/<%= tournament.id %>/matches/<%= match.id %>/update" class="td-admin-match-form">
                            <div class="td-admin-match-p1">
                                <select name="player1_id" class="td-admin-select" title="Chọn cơ thủ 1">
                                    <% allPlayersList.forEach(function(pl) { %>
                                        <option value="<%= pl.id %>" <%= (match.player1 && match.player1.id === pl.id) ? 'selected' : '' %>>
                                            #<%= pl.rank %> <%= pl.name %> (<%= pl.country %>)
                                        </option>
                                    <% }); %>
                                </select>
                            </div>

                            <div class="td-admin-match-scores">
                                <input type="number" name="score1" value="<%= match.score1 || 0 %>" min="0" max="<%= tournament.raceTarget || 9 %>" class="td-admin-score-input" required>
                                <span class="td-score-divider">VS</span>
                                <input type="number" name="score2" value="<%= match.score2 || 0 %>" min="0" max="<%= tournament.raceTarget || 9 %>" class="td-admin-score-input" required>
                            </div>

                            <div class="td-admin-match-p2">
                                <select name="player2_id" class="td-admin-select" title="Chọn cơ thủ 2">
                                    <% allPlayersList.forEach(function(pl) { %>
                                        <option value="<%= pl.id %>" <%= (match.player2 && match.player2.id === pl.id) ? 'selected' : '' %>>
                                            #<%= pl.rank %> <%= pl.name %> (<%= pl.country %>)
                                        </option>
                                    <% }); %>
                                </select>
                            </div>

                            <div class="td-admin-match-actions">
                                <label class="td-admin-live-toggle" title="Tích để phát trực tiếp">
                                    <input type="checkbox" name="is_live" <%= match.is_live ? 'checked' : '' %>>
                                    <span>LIVE</span>
                                </label>
                                <input type="text" name="scheduled" value="<%= match.scheduled || 'TBD' %>" class="td-admin-time-input" placeholder="Giờ thi đấu">
                                <button type="submit" class="td-admin-save-btn">💾 LƯU</button>
                            </div>
                        </form>
                    <% } else { %>
                        <!-- Giao diện xem bình thường dành cho User & Khách -->
                        <div class="td-match-seed">#<%= match.player1 && match.player1.rank ? match.player1.rank : '' %></div>
                        <div class="td-player td-player-left">
                            <span class="td-player-name"><%= match.player1 ? match.player1.name : 'TBD' %></span>
                            <span class="td-country"><%= match.player1 ? match.player1.country : '' %></span>
                        </div>

                        <div class="td-score-box">
                            <span class="td-score <%= Number(match.score1) === Number(tournament.raceTarget || 9) ? 'td-score-winner' : '' %>"><%= match.score1 || 0 %></span>
                            <span class="td-score-divider">vs</span>
                            <span class="td-score <%= Number(match.score2) === Number(tournament.raceTarget || 9) ? 'td-score-winner' : '' %>"><%= match.score2 || 0 %></span>
                        </div>

                        <div class="td-player td-player-right">
                            <span class="td-country"><%= match.player2 ? match.player2.country : '' %></span>
                            <span class="td-player-name"><%= match.player2 ? match.player2.name : 'TBD' %></span>
                        </div>
                        <div class="td-match-time">
                            <% if (match.is_live) { %>
                                <span class="td-live-indicator">● LIVE</span>
                            <% } %>
                            <%= match.scheduled || 'TBD' %>
                        </div>
                    <% } %>
                </div>
            <% }); %>
        </div>
    <% }); %>
</section>

<section id="live-section" class="td-live-wrap" style="display: none;">
    <div class="td-live-header">
        <div class="td-live-title">Live now</div>
        <div class="td-live-meta">
            Race to <%= tournament.raceTarget || 9 %>
            <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                <span class="td-admin-badge">⚡ CHẾ ĐỘ QUẢN TRỊ VIÊN</span>
            <% } %>
        </div>
    </div>

    <%
      const liveMatches = Array.isArray(tournament.matches)
        ? tournament.matches.flatMap(function(round) { return Array.isArray(round.matches) ? round.matches : []; })
            .filter(function(match) { return match.is_live === true || match.is_live === 1; })
        : [];
      const allTournamentMatches = Array.isArray(tournament.matches)
        ? tournament.matches.flatMap(function(round) { return Array.isArray(round.matches) ? round.matches : []; })
        : [];
    %>

    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
        <!-- Bảng điều khiển chọn trận Live cho Admin -->
        <div class="td-admin-live-panel">
            <h4 style="margin: 0 0 10px 0; color: #ffd24d; font-size: 0.9rem; text-transform: uppercase;">
                🔴 Quản lý trận đấu Live (Bật / Tắt trạng thái Live trực tiếp)
            </h4>
            <div class="td-admin-live-grid">
                <% allTournamentMatches.forEach(function(m) { %>
                    <form method="POST" action="/tournaments/<%= tournament.id %>/matches/<%= m.id %>/toggle-live" class="td-admin-live-card <%= m.is_live ? 'is-active-live' : '' %>">
                        <div class="td-admin-live-info">
                            <strong><%= m.player1 ? m.player1.name : 'TBD' %></strong> 
                            <span style="color: #ff4d4d; font-weight: 900;"> <%= m.score1 %> - <%= m.score2 %> </span> 
                            <strong><%= m.player2 ? m.player2.name : 'TBD' %></strong>
                            <small style="display: block; opacity: 0.7;"><%= m.round || 'Round 1' %> • <%= m.scheduled %></small>
                        </div>
                        <input type="hidden" name="is_live" value="<%= m.is_live ? '0' : '1' %>">
                        <button type="submit" class="td-admin-toggle-live-btn <%= m.is_live ? 'btn-live-off' : 'btn-live-on' %>" title="<%= m.is_live ? 'Tắt Live (Dừng phát)' : 'Bật Live (Phát trực tiếp)' %>">
                            <% if (m.is_live) { %>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
                            <% } else { %>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></svg>
                            <% } %>
                        </button>
                    </form>
                <% }); %>
            </div>
        </div>
    <% } %>

    <% if (liveMatches.length) { %>
        <% liveMatches.forEach(function(match) { %>
            <div class="td-live-row">
                <div class="td-live-seed">#<%= match.player1 && match.player1.rank ? match.player1.rank : '' %></div>
                <div class="td-live-player"><%= match.player1 ? match.player1.name : 'TBD' %> <span><%= match.player1 ? match.player1.country : '' %></span></div>
                <div class="td-live-score">
                    <span class="td-live-number <%= Number(match.score1) === Number(tournament.raceTarget || 9) ? 'td-live-number-winner' : '' %>"><%= match.score1 %></span>
                    <span class="td-live-divider">VS</span>
                    <span class="td-live-number <%= Number(match.score2) === Number(tournament.raceTarget || 9) ? 'td-live-number-winner' : '' %>"><%= match.score2 %></span>
                </div>
                <div class="td-live-player td-live-player-right"><%= match.player2 ? match.player2.name : 'TBD' %> <span><%= match.player2 ? match.player2.country : '' %></span></div>
                <div class="td-live-time">
                    <span class="td-live-indicator">● LIVE NOW</span>
                    <%= match.scheduled %>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="td-live-empty">Không có trận đấu nào đang diễn ra trực tiếp.</div>
    <% } %>
</section>

<section id="ranking-section" class="td-ranking-wrap" style="display: none;">
    <div class="td-ranking-header">
        <div class="td-ranking-title">Top 4 prize ranking</div>
        <div class="td-ranking-meta">
            <%= tournament.shortName || tournament.short_name || tournament.name %>
            <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                <span class="td-admin-badge">⚡ CHẾ ĐỘ QUẢN TRỊ VIÊN</span>
            <% } %>
        </div>
    </div>

    <%
      const rankingPlayers = Array.isArray(tournament.participants)
        ? tournament.participants.slice(0, 4)
        : [];
      const rankingPayouts = Array.isArray(tournament.prizeBreakdown) ? tournament.prizeBreakdown : [];
      const getPayout = function(position) {
        const prize = rankingPayouts.find(function(item) {
          return String(item.position || '').toLowerCase() === position;
        });
        return prize ? prize.amount : '—';
      };
      const semiFinalistPayout = getPayout('semi-finalists');
    %>

    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
        <!-- Form chỉnh sửa Top 4 người chơi trong giải dành cho Admin -->
        <div class="td-admin-ranking-box">
            <h4 style="margin: 0 0 14px 0; color: #ffd24d; font-size: 0.95rem; text-transform: uppercase;">
                🏆 Thay đổi thứ hạng Top 4 giải đấu trực tiếp:
            </h4>
            <form method="POST" action="/tournaments/<%= tournament.id %>/ranking/update" class="td-admin-ranking-form">
                <div class="td-admin-rank-field">
                    <label>🥇 Vô địch (Champion):</label>
                    <select name="rank1_id" class="td-admin-select">
                        <% allPlayersList.forEach(function(pl) { %>
                            <option value="<%= pl.id %>" <%= (rankingPlayers[0] && rankingPlayers[0].id === pl.id) ? 'selected' : '' %>>
                                #<%= pl.rank %> <%= pl.name %> (<%= pl.country %>)
                            </option>
                        <% }); %>
                    </select>
                </div>

                <div class="td-admin-rank-field">
                    <label>🥈 Á quân (Runner-up):</label>
                    <select name="rank2_id" class="td-admin-select">
                        <% allPlayersList.forEach(function(pl) { %>
                            <option value="<%= pl.id %>" <%= (rankingPlayers[1] && rankingPlayers[1].id === pl.id) ? 'selected' : '' %>>
                                #<%= pl.rank %> <%= pl.name %> (<%= pl.country %>)
                            </option>
                        <% }); %>
                    </select>
                </div>

                <div class="td-admin-rank-field">
                    <label>🥉 Hạng 3 (Semi-finalist 1):</label>
                    <select name="rank3_id" class="td-admin-select">
                        <% allPlayersList.forEach(function(pl) { %>
                            <option value="<%= pl.id %>" <%= (rankingPlayers[2] && rankingPlayers[2].id === pl.id) ? 'selected' : '' %>>
                                #<%= pl.rank %> <%= pl.name %> (<%= pl.country %>)
                            </option>
                        <% }); %>
                    </select>
                </div>

                <div class="td-admin-rank-field">
                    <label>🥉 Hạng 4 (Semi-finalist 2):</label>
                    <select name="rank4_id" class="td-admin-select">
                        <% allPlayersList.forEach(function(pl) { %>
                            <option value="<%= pl.id %>" <%= (rankingPlayers[3] && rankingPlayers[3].id === pl.id) ? 'selected' : '' %>>
                                #<%= pl.rank %> <%= pl.name %> (<%= pl.country %>)
                            </option>
                        <% }); %>
                    </select>
                </div>

                <button type="submit" class="td-admin-ranking-submit-btn">💾 CẬP NHẬT THỨ HẠNG GIẢI ĐẤU</button>
            </form>
        </div>
    <% } %>

    <% if (rankingPlayers.length) { %>
        <% rankingPlayers.forEach(function(player, index) { %>
            <div class="td-ranking-row <%= index === 0 ? 'td-ranking-row-first' : '' %>">
                <div class="td-ranking-place">#<%= index + 1 %></div>
                <% if (player.portrait) { %>
                    <img class="td-ranking-portrait" src="<%= player.portrait %>" alt="<%= player.name %>">
                <% } else { %>
                    <div class="td-ranking-flag"><%= player.flag || '🎱' %></div>
                <% } %>
                <div class="td-ranking-player">
                    <div class="td-ranking-name"><%= player.name %></div>
                    <div class="td-ranking-country"><%= player.country || '' %></div>
                </div>
                <div class="td-ranking-prize"><%= index === 0 ? getPayout('champion') : index === 1 ? getPayout('runner-up') : semiFinalistPayout %></div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="td-ranking-empty">Không có dữ liệu bảng xếp hạng giải đấu.</div>
    <% } %>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const infoTab = document.getElementById('tab-info');
    const matchesTab = document.getElementById('tab-matches');
    const liveTab = document.getElementById('tab-live');
    const rankingTab = document.getElementById('tab-ranking');
    const infoWrap = document.querySelector('.td-wrapper');
    const matchWrap = document.getElementById('matches-section');
    const liveWrap = document.getElementById('live-section');
    const rankingWrap = document.getElementById('ranking-section');

    function showInfo() {
      if (infoWrap) infoWrap.style.display = 'block';
      if (matchWrap) matchWrap.style.display = 'none';
      if (liveWrap) liveWrap.style.display = 'none';
      if (rankingWrap) rankingWrap.style.display = 'none';
      if (infoTab) infoTab.classList.add('td-tab-active');
      if (matchesTab) matchesTab.classList.remove('td-tab-active');
      if (liveTab) liveTab.classList.remove('td-tab-active');
      if (rankingTab) rankingTab.classList.remove('td-tab-active');
    }

    function showMatches() {
      if (infoWrap) infoWrap.style.display = 'none';
      if (matchWrap) matchWrap.style.display = 'block';
      if (liveWrap) liveWrap.style.display = 'none';
      if (rankingWrap) rankingWrap.style.display = 'none';
      if (matchesTab) matchesTab.classList.add('td-tab-active');
      if (infoTab) infoTab.classList.remove('td-tab-active');
      if (liveTab) liveTab.classList.remove('td-tab-active');
      if (rankingTab) rankingTab.classList.remove('td-tab-active');
    }

    function showLive() {
      if (infoWrap) infoWrap.style.display = 'none';
      if (matchWrap) matchWrap.style.display = 'none';
      if (liveWrap) liveWrap.style.display = 'block';
      if (rankingWrap) rankingWrap.style.display = 'none';
      if (liveTab) liveTab.classList.add('td-tab-active');
      if (matchesTab) matchesTab.classList.remove('td-tab-active');
      if (infoTab) infoTab.classList.remove('td-tab-active');
      if (rankingTab) rankingTab.classList.remove('td-tab-active');
    }

    function showRanking() {
      if (infoWrap) infoWrap.style.display = 'none';
      if (matchWrap) matchWrap.style.display = 'none';
      if (liveWrap) liveWrap.style.display = 'none';
      if (rankingWrap) rankingWrap.style.display = 'block';
      if (rankingTab) rankingTab.classList.add('td-tab-active');
      if (matchesTab) matchesTab.classList.remove('td-tab-active');
      if (liveTab) liveTab.classList.remove('td-tab-active');
      if (infoTab) infoTab.classList.remove('td-tab-active');
    }

    if (infoTab) {
      infoTab.addEventListener('click', function (event) {
        event.preventDefault();
        window.location.hash = 'info';
        showInfo();
      });
    }

    if (matchesTab) {
      matchesTab.addEventListener('click', function (event) {
        event.preventDefault();
        window.location.hash = 'matches';
        showMatches();
      });
    }

    if (liveTab) {
      liveTab.addEventListener('click', function (event) {
        event.preventDefault();
        window.location.hash = 'live';
        showLive();
      });
    }

    if (rankingTab) {
      rankingTab.addEventListener('click', function (event) {
        event.preventDefault();
        window.location.hash = 'ranking';
        showRanking();
      });
    }

    // Tự động mở đúng tab theo URL Hash (#matches, #live, #ranking)
    const hash = window.location.hash;
    if (hash === '#matches' || hash === '#matches-section') {
      showMatches();
    } else if (hash === '#live' || hash === '#live-section') {
      showLive();
    } else if (hash === '#ranking' || hash === '#ranking-section') {
      showRanking();
    } else {
      showInfo();
    }
  });
</script>

<style>
/* =================== TOURNAMENT DETAIL STYLES =================== */
main { padding-bottom: 0 !important; }

.td-hero {
    width: 100%;
    height: 280px;
    background-size: cover;
    background-position: center top;
    position: relative;
}
.td-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(10,13,30,0.25) 0%, rgba(10,13,30,0.55) 100%);
}

/* WRAPPER */
.td-wrapper {
    background: #fff;
    max-width: 980px;
    margin: -40px auto 120px auto;
    border-radius: 14px;
    box-shadow: 0 8px 40px rgba(0,0,0,0.18);
    padding: 0 0 30px 0;
    position: relative;
    z-index: 10;
}

/* EVENT INFO BADGE */
.td-info-badge-wrap {
    display: flex;
    justify-content: center;
    margin-top: -20px;
}
.td-info-badge {
    background: #0a1628;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    padding: 11px 50px;
    border-radius: 8px;
}

/* TITLE */
.td-title-block {
    text-align: center;
    padding: 28px 20px 0 20px;
}
.td-title {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 10px;
    font-size: 2.2rem;
    font-weight: 900;
    letter-spacing: 1px;
    flex-wrap: wrap;
    margin-bottom: 8px;
}
.td-title-gold { color: #c9a227; }
.td-title-blue { color: #1a2d5a; }
.td-title-divider {
    height: 2px;
    width: 80px;
    background: #c9a227;
    margin: 0 auto 20px auto;
    border-radius: 2px;
}

/* META GRID */
.td-meta-grid {
