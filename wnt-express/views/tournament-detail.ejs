    padding: 16px 40px 24px 40px;
    border-bottom: 1px solid #eee;
}
.td-meta-item {
    padding: 8px 16px;
    border-right: 1px solid #eee;
}
.td-meta-item:first-child { padding-left: 0; }
.td-meta-item:last-child { border-right: none; }
.td-meta-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #5a7fa8;
