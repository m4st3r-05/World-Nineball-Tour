    text-align: center;
    padding: 28px 20px 0 20px;
}
.td-title {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 10px;
    font-size: 2.2rem;
    font-weight: 900;
    letter-spacing: 1px;
    flex-wrap: wrap;
