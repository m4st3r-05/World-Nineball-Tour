                    <% if (user.role === 'admin') { %>
                        <li><a href="/admin">⚙️ Admin</a></li>
                    <% } %>
                    <li><a href="#">👤 My Profile</a></li>
                    <li><a href="#">❓ Support</a></li>
                    <li><a href="/logout">🚪 Logout</a></li>
                <% } else { %>
                    <li><a href="/login">👤 Login</a></li>
                    <li><a href="/register">📝 Register</a></li>
                <% } %>
            </ul>
        </nav>
    </header>
