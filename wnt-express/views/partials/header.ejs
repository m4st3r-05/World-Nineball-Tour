</head>

<body>
    <header class="navbar">
        <div class="logo">
            <h2 style="font-size: 2.5rem; font-style: italic; font-weight: 900; letter-spacing: -2px; color: #000;">wnt<span style="color: red;">.</span></h2>
        </div>
        <nav class="nav-center">
            <ul>
                <li><a href="/tournaments">EVENTS</a></li>
                <li><a href="/rankings">WORLD NINEBALL RANKINGS</a></li>
