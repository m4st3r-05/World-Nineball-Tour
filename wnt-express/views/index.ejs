<%- include('partials/header') %>

<section class="banner-section" style="margin-top: 20px;">
    <div class="container">
        <div class="banner-box" style="background: url('https://wntlivescores.com/images/banner.jpg') center/cover; height: 120px; border-radius: 8px; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: space-between; padding: 0 40px;">
            <div style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,13,20,0.8) 0%, rgba(10,13,20,0.3) 100%); z-index: 1;"></div>
            <div style="position: relative; z-index: 2; display: flex; align-items: center; width: 100%; justify-content: space-between;">
                <h2 style="font-size: 2rem; font-style: italic; font-weight: 900; color: #fff; text-transform: uppercase;">LIVE ACTION AT <span style="font-size: 2.5rem;">wnt<span style="color: red;">.</span>tv</span></h2>
                <a href="#" style="background: #ff2e63; color: white; padding: 10px 20px; font-weight: bold; font-style: italic; border-radius: 4px; text-decoration: none; text-transform: uppercase;">WATCH NOW</a>
            </div>
        </div>
    </div>
</section>

<section class="container mt-5 mb-5">
    <div class="grid tournaments-grid">
        <% tournaments.forEach(t => { %>
            <div class="event-card">
                <div class="event-card-img-wrap" style="background-image: url('<%= t.image || 'https://via.placeholder.com/400x300/333/fff?text=Waiting+for+image' %>');">
                    <div class="event-card-content">
                        <h3 class="event-title"><%= t.name %></h3>
                        <p class="event-location"><%= t.location %></p>
                    </div>
                </div>
                <div class="event-card-bottom">
                    <div class="event-date">📅 <%= t.date %></div>
                    <% if(t.type === 'Major') { %>
                        <span class="event-badge badge-major" style="position: static; margin-bottom: 0;">Major Event</span>
                    <% } else if(t.type === 'Ranking') { %>
                        <span class="event-badge badge-ranking" style="position: static; margin-bottom: 0;">Ranking Event</span>
                    <% } else { %>
                        <span class="event-badge badge-invitational" style="position: static; margin-bottom: 0;"><%= t.type %> Event</span>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>
</section>

<%- include('partials/footer') %>
